{
  "manifest_version": 3,
  "name": "Browser Workspace",
  "version": "0.3.3",
  "description": "Own named Chrome tab-group workspaces and lazy reusable tab pools for browser agents.",
  "permissions": [
    "storage",
    "tabs",
    "tabGroups",
    "webNavigation",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Browser Workspace"
  },
  "key": ""
}
