{
  "manifest_version": 3,
  "name": "WebHelm",
  "version": "0.4.1",
  "description": "Own named Chrome tab-group workspaces and lazy reusable tab pools for browser agents.",
  "permissions": [
    "storage",
    "tabs",
    "tabGroups",
    "webNavigation",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  },
  "icons": { "16": "icons/webhelm-16.png", "32": "icons/webhelm-32.png", "48": "icons/webhelm-48.png", "128": "icons/webhelm-128.png" },
  "action": {
    "default_title": "WebHelm",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/webhelm-16.png", "32": "icons/webhelm-32.png" }
  },
  "key": ""
}
